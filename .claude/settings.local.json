{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/api/health)",
      "Bash(curl -s http://localhost:3000/api/health)",
      "Bash(npx tsx *)",
      "Bash(cd *)",
      "Bash(node -e ' *)",
      "Bash(env)",
      "Bash(curl -s \"http://localhost:3000/api/events?limit=80\")",
      "Bash(rm -f agent-run-result.json dev-server.log)",
      "Bash(git add *)",
      "Bash(git commit -m 'fix: campaign discounts now reach the signed mandate and the real charge *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.argv[1];const f=require('fs');if(f.existsSync(p)){const r=require('child_process').spawnSync(process.execPath,[p],{stdio:'inherit'});process.exit(r.status===null?1:r.status);}\" \"C:\\\\Users\\\\yadav\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.argv[1];const f=require('fs');if(f.existsSync(p)){const r=require('child_process').spawnSync(process.execPath,[p],{stdio:'inherit'});process.exit(r.status===null?1:r.status);}\" \"C:\\\\Users\\\\yadav\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
