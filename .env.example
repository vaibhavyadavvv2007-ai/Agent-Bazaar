# ── Razorpay test-mode keys ─────────────────────────────────────────────
# dashboard.razorpay.com → Settings → API Keys → Generate Test Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Secret you invent, then paste when registering the webhook
# (Dashboard → Settings → Webhooks → https://<your-app>/api/webhooks/razorpay,
#  events: payment.captured + payment.failed)
RAZORPAY_WEBHOOK_SECRET=whsec_pick_a_long_random_string

# Public test key — safe to expose, used by the hosted checkout page.
# (Same rzp_test_ key id as above; needed as NEXT_PUBLIC_ for Checkout.js.)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── Database ────────────────────────────────────────────────────────────
# Leave both empty for local dev (file-backed SQLite at ./data/bazaar.db).
# For the deployed demo, create a free Turso DB and fill these in.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── App ─────────────────────────────────────────────────────────────────
# Public base URL of this deployment (webhook registration, MCP clients).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Agent providers (only needed on agent days) ────────────────────────
CLAUDE_API_KEY=
GROQ_API_KEY=
